{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "incremental": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": false,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "allowUnusedLabels": false,
    "allowUnreachableCode": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "paths": {
      "@repo-intel/shared": ["./packages/shared/src/index.ts"],
      "@repo-intel/shared/*": ["./packages/shared/src/*"],
      "@repo-intel/parser": ["./packages/parser/src/index.ts"],
      "@repo-intel/parser/*": ["./packages/parser/src/*"],
      "@repo-intel/graph": ["./packages/graph/src/index.ts"],
      "@repo-intel/graph/*": ["./packages/graph/src/*"],
      "@repo-intel/retrieval": ["./packages/retrieval/src/index.ts"],
      "@repo-intel/retrieval/*": ["./packages/retrieval/src/*"],
      "@repo-intel/ai": ["./packages/ai/src/index.ts"],
      "@repo-intel/ai/*": ["./packages/ai/src/*"],
      "@repo-intel/review-engine": ["./packages/review-engine/src/index.ts"],
      "@repo-intel/review-engine/*": ["./packages/review-engine/src/*"],
      "@repo-intel/agents": ["./packages/agents/src/index.ts"],
      "@repo-intel/agents/*": ["./packages/agents/src/*"],
      "@repo-intel/patch-gen": ["./packages/patch-gen/src/index.ts"],
      "@repo-intel/patch-gen/*": ["./packages/patch-gen/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", "build", "coverage"]
}

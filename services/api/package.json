{
  "name": "@repo-intel/api",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc --build --force",
    "check-types": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "tsx --test src/**/*.test.ts",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/swagger": "^8.14.0",
    "@fastify/swagger-ui": "^3.0.0",
    "@repo-intel/shared": "workspace:*",
    "@repo-intel/parser": "workspace:*",
    "@repo-intel/graph": "workspace:*",
    "@repo-intel/retrieval": "workspace:*",
    "@repo-intel/ai": "workspace:*",
    "@repo-intel/review-engine": "workspace:*",
    "@repo-intel/patch-gen": "workspace:*",
    "fastify": "^5.8.5"
  },
  "devDependencies": {
    "@types/node": "^26.1.1"
  }
}

{
  "name": "repo-intelligence-platform",
  "version": "0.6.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "description": "Enterprise-grade, graph-aware, multi-agent code analysis and repository intelligence platform",
  "author": "Antigravity",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc --build",
    "lint": "eslint . --ext .ts,.tsx",
    "check-types": "tsc --build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --config=apps/web/playwright.config.ts",
    "clean": "git clean -Xdf"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  }
}
